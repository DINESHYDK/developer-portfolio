{
  "name": "ydk-portfolio-trailer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "studio": "npm run prepare-assets && remotion studio src/index.ts",
    "render": "npm run prepare-assets && remotion render src/index.ts Trailer out/trailer.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "@remotion/media": "^4.0.543",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
